generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum TaskType {
  CALL
  MEETING
  EMAIL
  TASK
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  SYSTEM
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_STAGE_CHANGED
}

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  currency      String   @default("USD")
  timezone      String   @default("UTC")
  monthlyTarget Int      @default(50000)
  leadSources   String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
  companies     Company[]
  contacts      Contact[]
  leads         Lead[]
  stages        DealStage[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  notes         Note[]
  rules         AutomationRule[]
  runs          AutomationRun[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships   Membership[]
  leads         Lead[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  notes         Note[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(SALES_REP)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Company {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  website   String?
  industry  String?
  phone     String?
  address   String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]

  @@index([orgId, name])
}

model Contact {
  id        String   @id @default(cuid())
  orgId     String
  firstName String
  lastName  String   @default("")
  email     String?
  phone     String?
  jobTitle  String?
  companyId String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  tasks      Task[]
  activities Activity[]
  notes      Note[]

  @@index([orgId])
  @@index([companyId])
  @@index([orgId, email])
}

model Lead {
  id           String     @id @default(cuid())
  orgId        String
  name         String
  email        String?
  phone        String?
  companyName  String?
  source       String
  status       LeadStatus @default(NEW)
  priority     Priority   @default(MEDIUM)
  value        Int        @default(0)
  notes        String?
  followUpAt   DateTime?
  assignedToId String?
  contactId    String?
  convertedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  tasks      Task[]
  activities Activity[]
  notesList  Note[]

  @@index([orgId, status])
  @@index([orgId, assignedToId])
  @@index([orgId, archivedAt])
  @@index([orgId, createdAt])
  @@index([orgId, followUpAt])
}

model DealStage {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  kind        StageKind @default(OPEN)
  position    Int
  probability Int       @default(0)
  createdAt   DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deals Deal[]

  @@unique([orgId, name])
  @@index([orgId, position])
}

model Deal {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  value           Int       @default(0)
  probability     Int       @default(0)
  expectedCloseAt DateTime?
  stageId         String
  ownerId         String?
  contactId       String?
  companyId       String?
  leadId          String?
  lossReason      String?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stage      DealStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks      Task[]
  activities Activity[]
  notes      Note[]

  @@index([orgId, stageId])
  @@index([orgId, ownerId])
  @@index([orgId, closedAt])
}

model Task {
  id             String    @id @default(cuid())
  orgId          String
  title          String
  description    String?
  type           TaskType  @default(TASK)
  priority       Priority  @default(MEDIUM)
  dueAt          DateTime?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  completedAt    DateTime?
  assigneeId     String?
  leadId         String?
  contactId      String?
  dealId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  lead     Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal     Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, assigneeId, completedAt])
  @@index([orgId, dueAt])
  @@index([reminderAt])
}

model Activity {
  id         String       @id @default(cuid())
  orgId      String
  type       ActivityType
  subject    String
  body       String?
  userId     String?
  leadId     String?
  contactId  String?
  dealId     String?
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
}

model Note {
  id        String   @id @default(cuid())
  orgId     String
  body      String
  authorId  String?
  leadId    String?
  contactId String?
  dealId    String?
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  lead    Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
}

model AutomationRule {
  id          String            @id @default(cuid())
  orgId       String
  name        String
  trigger     AutomationTrigger
  conditions  Json              @default("[]")
  actions     Json              @default("[]")
  active      Boolean           @default(true)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  org  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([orgId, trigger, active])
}

model AutomationRun {
  id         String    @id @default(cuid())
  orgId      String
  ruleId     String
  entityType String
  entityId   String
  dedupeKey  String
  status     RunStatus @default(RUNNING)
  attempts   Int       @default(0)
  error      String?
  log        Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dedupeKey])
  @@index([orgId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}
