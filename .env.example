# --- Database ---
DATABASE_URL="postgresql://salesflow:salesflow@localhost:5432/salesflow?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 48   (min 32 chars)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- App ---
APP_URL="http://localhost:3000"
# Secret for /api/cron/reminders (call it every few minutes from a scheduler). Leave blank to disable.
CRON_SECRET=""

# --- Email (SMTP). Leave SMTP_HOST empty for DEV MODE: emails are logged to the server console. ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SalesFlow CRM <no-reply@salesflow.local>"
